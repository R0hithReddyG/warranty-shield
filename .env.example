# Warranty Shield — Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=Warranty Shield
APP_VERSION=1.0.0
ENVIRONMENT=development  # development | staging | production
DEBUG=true

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_CLIENT_CACHE_SESSION_STATE=true

# Database
DATABASE_URL=sqlite:///./data/warranty_shield.db
DB_ECHO=false

# LangGraph / LangChain (optional — for future agentic workflows)
LANGGRAPH_ENABLED=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=warranty-shield
LANGCHAIN_TRACING_V2=true

# Anthropic (optional — for LLM-powered narrative analysis)
ANTHROPIC_API_KEY=

# Security
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=INFO